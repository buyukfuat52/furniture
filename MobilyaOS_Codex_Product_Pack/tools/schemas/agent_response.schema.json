{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "facts",
    "proposed_actions",
    "approval",
    "warnings",
    "missing_information",
    "references"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "needs_input",
        "needs_approval",
        "failed",
        "informational"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "source"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "revision_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool_call_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "description",
          "risk",
          "approval_required"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "read_only",
              "low",
              "financial",
              "external",
              "production",
              "destructive"
            ]
          },
          "approval_required": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "not_required",
            "missing",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
