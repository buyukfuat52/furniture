{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "retryable",
    "trace_id"
  ],
  "properties": {
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "field_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "trace_id": {
      "type": "string"
    }
  }
}
